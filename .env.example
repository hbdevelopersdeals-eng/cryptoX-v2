# CryptoX environment template. Copy to `.env.local` for development.
# All values are inlined at build time by Vite — never put secrets here.

# Shown on the System Status page and in error reports.
VITE_APP_VERSION=1.0.0
# Stamped by CI so a deployed build can be traced back to a commit.
VITE_BUILD_STAMP=local

# ---------------------------------------------------------------------------
# REQUIRED FOR A REAL DEPLOYMENT — identity and billing both depend on these.
#
# Without them `src/lib/auth.jsx` falls back to the demo identity store, where
# accounts live in localStorage. The app still renders and checkout still opens,
# but a paying customer has no server-side account for the Lemon Squeezy webhook
# to attach a subscription to — the money arrives attached to nobody.
#
#   VITE_SUPABASE_URL                  https://<project-ref>.supabase.co
#   VITE_SUPABASE_PUBLISHABLE_KEY      sb_publishable_… (or the legacy anon JWT)
#
# Both are PUBLIC by design: Vite inlines every VITE_ value into the bundle.
# The privileged admin key must never appear here — `scripts/check-deploy-env.mjs`
# refuses a build whose key carries an admin role claim, and `npm run check`
# fails when either value is missing.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: HTTPS endpoint that receives structured client error reports
# (POST, JSON body). Leave empty to keep telemetry local-only, which means an
# error in production is only visible to the user who hit it.
VITE_ERROR_ENDPOINT=

# ---------------------------------------------------------------------------
# SEARCH ENGINE OWNERSHIP (build-time, public by design)
#
# Both are rendered into <head> by scripts/prerender.mjs, which runs as
# postbuild. They must be tags in the served HTML: neither Google nor Bing
# accepts a verification tag injected by JavaScript. Leave empty and no tag is
# emitted, which is the correct state for a local build.
#
#   GOOGLE_SITE_VERIFICATION   Search Console → URL prefix property → HTML tag
#   BING_SITE_VERIFICATION     Bing Webmaster Tools → Verify → Meta tag
# ---------------------------------------------------------------------------
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
