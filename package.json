{
  "name": "accio-react-vite-base",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --omit=dev",
    "check:config": "node scripts/check-config.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:locales": "node scripts/check-locales.mjs --strict",
    "check:i18n": "node scripts/check-i18n-usage.mjs",
    "check:frontend": "node scripts/check-frontend.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:deploy": "node scripts/check-deploy-env.mjs --strict",
    "check:matrix": "node scripts/check-production-matrix.mjs",
    "seo:sitemap": "node scripts/gen-sitemap.mjs",
    "seo:check": "node scripts/gen-sitemap.mjs --check",
    "seo:prerender:check": "node scripts/prerender.mjs --check",
    "check": "npm run check:secrets && npm run check:deploy && npm run check:config && npm run check:locales && npm run check:i18n && npm run check:frontend && npm run check:schema && npm run check:matrix && npm run seo:check && npm run build && npm run seo:prerender:check && npm run check:bundle",
    "verify": "npm run test && npm run check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "0.469.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@rollup/wasm-node": "4.24.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^5.1.1",
    "autoprefixer": "^10.6.2",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.6",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.24.4"
  },
  "pnpm": {
    "overrides": {
      "rollup": "npm:@rollup/wasm-node@4.24.4"
    }
  }
}
